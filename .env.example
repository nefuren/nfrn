# IP TEST DESK 設定ファイルの見本。
# このファイルを .env にコピーして値を埋めてください。.env は絶対にコミットしないこと。
#
# トークンの作り方（32文字以上が必須）:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DESK_TOKEN=

# 待ち受け先。外部に公開しないため 127.0.0.1 のまま使うことを強く推奨します。
DESK_HOST=127.0.0.1
DESK_PORT=8787

# ブラウザの Origin / Host の許可リスト（カンマ区切り）
DESK_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173
DESK_ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS 越しに使う場合のみ true
DESK_COOKIE_SECURE=false

# 国判定用のローカル GeoIP DB（scripts/fetch_geoip.py で取得）。空なら国は「??」表示
DESK_GEOIP_DB=data/dbip-country-lite.mmdb

# Linux のみ: 認証ログの場所
DESK_AUTH_LOG=/var/log/auth.log

# 脆弱性チェックの追加対象ディレクトリ（カンマ区切り。requirements.txt または package-lock.json がある場所）
DESK_AUDIT_PATHS=
DESK_AUDIT_INTERVAL_SECONDS=21600
